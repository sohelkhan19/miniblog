/build

# OS-specific files
.DS_Store
Thumbs.db

# IDEs & Editor settings
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Composer & Node lock files (optional to ignore)
/composer.lock
/package-lock.json
/pnpm-lock.yaml
/yarn.lock

